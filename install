#!/usr/bin/env bash
# oafish installer — detects agents, runs the right install path
# Usage: curl -fsSL https://oafish.bitclaw.com/install | bash
#        bash install [--dry-run] [--only <agent>] [--minimal]

set -euo pipefail

REPO="bitclaw/oafish"
DRY_RUN=0
MINIMAL=0
ONLY=()

# ── Args ──────────────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --minimal) MINIMAL=1 ;;
    --only) ONLY+=("$2"); shift ;;
    --help|-h)
      echo "Usage: bash install [--dry-run] [--minimal] [--only <agent>]"
      echo ""
      echo "  --dry-run    Preview installs, write nothing"
      echo "  --minimal    Skip hooks and statusline for Claude Code"
      echo "  --only       Install for specific agent only (repeatable)"
      echo ""
      echo "Agents: claude, cursor, windsurf, cline, copilot, opencode, gemini, codex, skills"
      exit 0
      ;;
    *) echo "Unknown flag: $1" >&2; exit 1 ;;
  esac
  shift
done

# ── Helpers ───────────────────────────────────────────────────────────────
say()  { printf '  %s\n' "$*"; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
skip() { printf '  \033[90m–\033[0m %s\n' "$*"; }
err()  { printf '  \033[31m✗\033[0m %s\n' "$*" >&2; }

want() {
  [[ ${#ONLY[@]} -eq 0 ]] || [[ " ${ONLY[*]} " == *" $1 "* ]]
}

try() {
  if [[ $DRY_RUN -eq 1 ]]; then
    say "[dry-run] $*"
    return 0
  fi
  "$@"
}

# Detect command or directory/file existence
detect() {
  local spec="$1"
  IFS='||' read -ra parts <<< "$spec"
  for part in "${parts[@]}"; do
    part="${part## }"; part="${part%% }"
    if [[ "$part" == command:* ]]; then
      command -v "${part#command:}" &>/dev/null && return 0
    elif [[ "$part" == dir:* ]]; then
      [[ -d "${part#dir:}" ]] && return 0
    elif [[ "$part" == file:* ]]; then
      [[ -f "${part#file:}" ]] && return 0
    fi
  done
  return 1
}

# Write oafish rules to a file-based agent path
write_rules() {
  local label="$1"
  local dest="$2"
  local content
  content="$(cat "$SCRIPT_DIR/rules/oafish.md" 2>/dev/null || echo "# oafish — see https://github.com/$REPO")"

  say "$label → $dest"
  if [[ $DRY_RUN -eq 0 ]]; then
    mkdir -p "$(dirname "$dest")"
    printf '%s\n' "$content" > "$dest"
  fi
  ok "$label installed"
}

# Install via npx skills (fallback for agents without known file paths)
install_skills() {
  local label="$1"
  local profile="$2"
  say "$label → npx skills add $REPO -a $profile"
  if ! command -v npx &>/dev/null; then
    err "$label: npx not found — install Node.js first"
    return 1
  fi
  try npx -y skills add "$REPO" -a "$profile" && ok "$label installed"
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALLED=()

echo ""
echo "  🔇 oafish — output compression installer"
echo ""

# ── Path 1: Claude Code ───────────────────────────────────────────────────
if want claude && detect "command:claude"; then
  say "Claude Code detected"
  try claude plugin marketplace add "$REPO" && \
  try claude plugin install oafish@oafish && \
  ok "Claude Code plugin installed"
  INSTALLED+=(claude)

  if [[ $MINIMAL -eq 0 ]]; then
    # Statusline
    CLAUDE_CFG="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    SETTINGS="$CLAUDE_CFG/settings.json"
    STATUSLINE_CMD="bash \"$SCRIPT_DIR/hooks/statusline\""

    if [[ -f "$SETTINGS" ]] && grep -q '"statusLine"' "$SETTINGS" 2>/dev/null; then
      skip "statusline already configured"
    else
      say "Adding statusline to $SETTINGS"
      if [[ $DRY_RUN -eq 0 ]]; then
        if [[ -f "$SETTINGS" ]]; then
          # Insert statusLine before closing brace
          tmp=$(mktemp)
          python3 -c "
import json, sys
s = json.load(open('$SETTINGS'))
s['statusLine'] = {'type': 'command', 'command': '$STATUSLINE_CMD'}
json.dump(s, open('$tmp', 'w'), indent=2)
" && mv "$tmp" "$SETTINGS" && ok "Statusline configured"
        else
          mkdir -p "$CLAUDE_CFG"
          printf '{\n  "statusLine": { "type": "command", "command": "%s" }\n}\n' \
            "$STATUSLINE_CMD" > "$SETTINGS"
          ok "Statusline configured (new settings.json)"
        fi
      else
        say "[dry-run] Would add statusLine to $SETTINGS"
      fi
    fi
  fi
elif want claude; then
  skip "Claude Code not found (install from https://claude.ai/code)"
fi

# ── Path 2: File-based agents ─────────────────────────────────────────────

# Cursor
if want cursor && detect "command:cursor||dir:$HOME/.cursor"; then
  write_rules "Cursor" ".cursor/rules/oafish.md"
  INSTALLED+=(cursor)
elif want cursor; then
  skip "Cursor not found"
fi

# Windsurf
if want windsurf && detect "command:windsurf||dir:$HOME/.codeium/windsurf||dir:$HOME/.windsurf"; then
  write_rules "Windsurf" ".windsurf/rules/oafish.md"
  INSTALLED+=(windsurf)
elif want windsurf; then
  skip "Windsurf not found"
fi

# Cline
if want cline && detect "dir:$HOME/.vscode/extensions||dir:$HOME/.cursor/extensions"; then
  if find "${HOME}/.vscode/extensions" "${HOME}/.cursor/extensions" \
     -maxdepth 1 -name "saoudrizwan.claude-dev*" 2>/dev/null | grep -q .; then
    write_rules "Cline" ".clinerules/oafish.md"
    INSTALLED+=(cline)
  elif want cline; then
    skip "Cline not found"
  fi
fi

# GitHub Copilot
if want copilot && detect "command:gh"; then
  write_rules "GitHub Copilot" ".github/copilot-instructions.md"
  INSTALLED+=(copilot)
elif want copilot; then
  skip "GitHub Copilot (gh) not found"
fi

# opencode — native plugin (opencode.json) with AGENTS.md fallback
OPENCODE_CFG="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
OPENCODE_JSON="$OPENCODE_CFG/opencode.json"
OPENCODE_AGENTS="$OPENCODE_CFG/AGENTS.md"
if want opencode && detect "command:opencode||file:$OPENCODE_AGENTS||dir:$OPENCODE_CFG"; then
  # Try native plugin install first (opencode ≥ 0.3)
  if command -v opencode &>/dev/null && opencode --version 2>/dev/null | grep -qE '^0\.[3-9]|^[1-9]'; then
    say "opencode → $OPENCODE_JSON (native plugin)"
    if [[ $DRY_RUN -eq 0 ]]; then
      mkdir -p "$OPENCODE_CFG"
      python3 - "$OPENCODE_JSON" <<'EOF'
import sys, json, os
path = sys.argv[1]
data = {}
if os.path.exists(path):
    with open(path) as f:
        data = json.load(f)
plugins = data.get("plugin", [])
if "oafish" not in plugins:
    plugins.append("oafish")
data["plugin"] = plugins
with open(path, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
EOF
    fi
    ok "opencode native plugin registered"
  else
    # Fallback: write rules to AGENTS.md for older opencode versions
    write_rules "opencode" "$OPENCODE_AGENTS"
  fi
  INSTALLED+=(opencode)
elif want opencode; then
  skip "opencode not found"
fi

# Gemini CLI
if want gemini && detect "command:gemini"; then
  write_rules "Gemini CLI" "GEMINI.md"
  INSTALLED+=(gemini)
elif want gemini; then
  skip "Gemini CLI not found"
fi

# ── Path 3: Skills-based agents ───────────────────────────────────────────

if want codex && detect "command:codex"; then
  say "Codex → codex plugin marketplace add $REPO"
  try codex plugin marketplace add "$REPO" && ok "Codex plugin installed" \
    || install_skills "Codex" "codex"
  INSTALLED+=(codex)
elif want codex; then
  skip "Codex not found"
fi

if want roo && detect "dir:$HOME/.vscode/extensions" && \
   find "$HOME/.vscode/extensions" -maxdepth 1 -name "rooveterinaryinc*" 2>/dev/null | grep -q .; then
  install_skills "Roo Code" "roo"
  INSTALLED+=(roo)
fi

if want amp && detect "command:amp"; then
  install_skills "Sourcegraph Amp" "amp"
  INSTALLED+=(amp)
elif want amp; then
  skip "Amp not found"
fi

if want goose && detect "command:goose||dir:$HOME/.config/goose"; then
  install_skills "Goose" "goose"
  INSTALLED+=(goose)
elif want goose; then
  skip "Goose not found"
fi

# ── Summary ───────────────────────────────────────────────────────────────
echo ""
if [[ ${#INSTALLED[@]} -eq 0 ]]; then
  err "No agents detected. Install Claude Code, Cursor, Windsurf, opencode, or another agent first."
  echo ""
  echo "  Manual: copy rules/oafish.md to your agent's rules directory."
  echo "  Docs:   https://oafish.bitclaw.com"
  echo ""
  exit 1
fi

echo "  Installed for: ${INSTALLED[*]}"
echo ""
echo "  Usage: /oafish          activate"
echo "         /oafish lite     low compression"
echo "         /oafish ultra    maximum compression"
echo "         stop oafish      deactivate"
echo ""
