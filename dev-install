#!/usr/bin/env bash
# dev-install — register local oafish repo for local agent development
# Run once after cloning. Re-run after hook changes (with bun run build first).
# Usage:
#   bash dev-install                        # Claude Code (default)
#   bash dev-install --agent opencode       # opencode
#   bash dev-install --agent codex          # Codex CLI
#   bash dev-install --agent claude         # Claude Code (explicit)
#   bash dev-install --uninstall            # remove (uses current --agent)

set -euo pipefail

PLUGIN_KEY="oafish@oafish"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
PLUGINS_JSON="$CLAUDE_DIR/plugins/installed_plugins.json"
SETTINGS_JSON="$CLAUDE_DIR/settings.json"
AGENT="claude"
UNINSTALL=0

# ── helpers ───────────────────────────────────────────────────────────────

ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
info() { printf '  \033[34m→\033[0m %s\n' "$*"; }
err()  { printf '  \033[31m✗\033[0m %s\n' "$*" >&2; exit 1; }

require_python() {
  command -v python3 &>/dev/null || err "python3 required"
}

# ── flags ─────────────────────────────────────────────────────────────────

while [[ $# -gt 0 ]]; do
  case "$1" in
    --agent|-a)
      AGENT="${2:-}"; shift 2 ;;
    --uninstall|-u)
      UNINSTALL=1; shift ;;
    --help|-h)
      echo "Usage: bash dev-install [--agent claude|opencode|codex] [--uninstall]"
      echo ""
      echo "  --agent    Target agent (default: claude)"
      echo "  --uninstall  Remove dev registration for the agent"
      exit 0
      ;;
    *) err "Unknown flag: $1" ;;
  esac
done

# ── Claude Code ───────────────────────────────────────────────────────────

install_claude() {
  require_python

  [[ -f "$REPO_ROOT/.claude-plugin/plugin.json" ]] \
    || err "Not an oafish repo root: $REPO_ROOT"

  [[ -f "$REPO_ROOT/hooks/dist/activate.js" ]] \
    || err "Build missing. Run: bun run build"

  [[ -d "$CLAUDE_DIR" ]] \
    || err "Claude Code config dir not found: $CLAUDE_DIR"

  mkdir -p "$CLAUDE_DIR/plugins"

  NOW="$(date -u +%Y-%m-%dT%H:%M:%S.000Z)"

  python3 - "$PLUGINS_JSON" "$PLUGIN_KEY" "$REPO_ROOT" "$NOW" <<'EOF'
import sys, json, os
path, key, repo_root, now = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
if os.path.exists(path):
    with open(path) as f:
        data = json.load(f)
else:
    data = {"version": 2, "plugins": {}}
entry = {
    "scope": "user",
    "installPath": repo_root,
    "version": "local",
    "installedAt": now,
    "lastUpdated": now,
    "gitCommitSha": "local"
}
plugins = data.setdefault("plugins", {})
existing = plugins.get(key, [])
existing = [p for p in existing if p.get("version") != "local"]
existing.insert(0, entry)
plugins[key] = existing
data["plugins"] = plugins
with open(path, "w") as f:
    json.dump(data, f, indent=4)
    f.write("\n")
EOF

  ok "Registered in installed_plugins.json"

  if [[ ! -f "$SETTINGS_JSON" ]]; then
    echo '{}' > "$SETTINGS_JSON"
  fi

  python3 - "$SETTINGS_JSON" "$PLUGIN_KEY" "$REPO_ROOT" <<'EOF'
import sys, json
path, key, repo_root = sys.argv[1], sys.argv[2], sys.argv[3]
marketplace_name = key.split("@")[1]
with open(path) as f:
    data = json.load(f)
data.setdefault("enabledPlugins", {})[key] = True
data.setdefault("extraKnownMarketplaces", {})[marketplace_name] = {
    "source": {"source": "directory", "path": repo_root}
}
with open(path, "w") as f:
    json.dump(data, f, indent=4)
    f.write("\n")
EOF

  ok "Enabled in settings.json (enabledPlugins + extraKnownMarketplaces)"
  echo ""
  echo "  Plugin: $PLUGIN_KEY"
  echo "  Path:   $REPO_ROOT"
  echo ""
  info "Restart Claude Code to activate."
  info "Verify with: /oafish-help"
}

uninstall_claude() {
  require_python

  if [[ ! -f "$PLUGINS_JSON" ]]; then
    info "No installed_plugins.json found — nothing to remove."
    exit 0
  fi

  python3 - "$PLUGINS_JSON" "$PLUGIN_KEY" <<'EOF'
import sys, json
path, key = sys.argv[1], sys.argv[2]
with open(path) as f:
    data = json.load(f)
plugins = data.get("plugins", {})
if key in plugins:
    plugins[key] = [p for p in plugins[key] if p.get("version") != "local"]
    if not plugins[key]:
        del plugins[key]
data["plugins"] = plugins
with open(path, "w") as f:
    json.dump(data, f, indent=4)
    f.write("\n")
EOF

  if [[ -f "$SETTINGS_JSON" ]]; then
    python3 - "$SETTINGS_JSON" "$PLUGIN_KEY" <<'EOF'
import sys, json
path, key = sys.argv[1], sys.argv[2]
marketplace_name = key.split("@")[1]
with open(path) as f:
    data = json.load(f)
enabled = data.get("enabledPlugins", {})
enabled.pop(key, None)
if enabled:
    data["enabledPlugins"] = enabled
else:
    data.pop("enabledPlugins", None)
marketplaces = data.get("extraKnownMarketplaces", {})
marketplaces.pop(marketplace_name, None)
if marketplaces:
    data["extraKnownMarketplaces"] = marketplaces
else:
    data.pop("extraKnownMarketplaces", None)
with open(path, "w") as f:
    json.dump(data, f, indent=4)
    f.write("\n")
EOF
  fi

  ok "Removed dev plugin. Restart Claude Code."
}

# ── opencode ──────────────────────────────────────────────────────────────

OPENCODE_PLUGINS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/plugins"
OPENCODE_PLUGIN_LINK="$OPENCODE_PLUGINS_DIR/oafish.js"

install_opencode() {
  local plugin_src="$REPO_ROOT/agents/opencode/dist/plugin.js"

  [[ -f "$plugin_src" ]] \
    || err "Build missing: $plugin_src — run: bun run build"

  mkdir -p "$OPENCODE_PLUGINS_DIR"

  # Remove stale link before re-creating
  rm -f "$OPENCODE_PLUGIN_LINK"
  ln -s "$plugin_src" "$OPENCODE_PLUGIN_LINK"

  ok "Symlinked opencode plugin"
  echo ""
  echo "  Link:   $OPENCODE_PLUGIN_LINK"
  echo "  Target: $plugin_src"
  echo ""
  info "Start opencode — plugin auto-loads from global plugins dir."
  info "Verify: oafish rules appear in system prompt context."
}

uninstall_opencode() {
  if [[ -L "$OPENCODE_PLUGIN_LINK" ]]; then
    rm "$OPENCODE_PLUGIN_LINK"
    ok "Removed opencode plugin symlink."
  else
    info "No symlink found at $OPENCODE_PLUGIN_LINK — nothing to remove."
  fi
}

# ── Codex CLI ─────────────────────────────────────────────────────────────

install_codex() {
  [[ -f "$REPO_ROOT/.codex-plugin/plugin.json" ]] \
    || err "Not an oafish repo root: $REPO_ROOT"

  [[ -f "$REPO_ROOT/hooks/dist/activate.js" ]] \
    || err "Build missing. Run: bun run build"

  command -v codex &>/dev/null || err "codex CLI not found"

  codex plugin marketplace add "$REPO_ROOT"

  ok "Registered Codex plugin from local path"
  echo ""
  echo "  Path: $REPO_ROOT"
  echo ""
  info "Restart Codex to activate."
  info "Verify: skills and hooks load on session start."
}

uninstall_codex() {
  command -v codex &>/dev/null || err "codex CLI not found"
  # Codex doesn't have a remove command yet; remove manually
  local codex_plugins="$HOME/.codex/plugins/oafish"
  if [[ -d "$codex_plugins" ]]; then
    rm -rf "$codex_plugins"
    ok "Removed Codex plugin directory: $codex_plugins"
  else
    info "No Codex plugin directory found at $codex_plugins — nothing to remove."
  fi
}

# ── dispatch ──────────────────────────────────────────────────────────────

case "$AGENT" in
  claude)
    if [[ $UNINSTALL -eq 1 ]]; then uninstall_claude; else install_claude; fi ;;
  opencode)
    if [[ $UNINSTALL -eq 1 ]]; then uninstall_opencode; else install_opencode; fi ;;
  codex)
    if [[ $UNINSTALL -eq 1 ]]; then uninstall_codex; else install_codex; fi ;;
  *)
    err "Unknown agent: $AGENT. Valid: claude, opencode, codex" ;;
esac
